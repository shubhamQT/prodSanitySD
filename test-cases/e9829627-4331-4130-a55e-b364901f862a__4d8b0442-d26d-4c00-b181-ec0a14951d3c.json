{
  "id": "4d8b0442-d26d-4c00-b181-ec0a14951d3c",
  "testPlanId": "e9829627-4331-4130-a55e-b364901f862a",
  "requirementId": "397f96ea-480b-48dd-99ed-2fcea12a8b5c",
  "suiteName": "PS-001 — Product Listing & Add to Cart E2E",
  "case": {
    "id": "4d8b0442-d26d-4c00-b181-ec0a14951d3c",
    "title": "E2E-012: Remove product from cart page and verify cart is empty",
    "priority": "P0",
    "platforms": [
      "chrome"
    ],
    "preconditions": [
      "User has valid credentials: standard_user / secret_sauce"
    ],
    "steps": [
      {
        "id": "s1",
        "action": "openUrl",
        "targetDescription": "Navigate to SauceDemo login page",
        "value": "https://www.saucedemo.com/"
      },
      {
        "id": "s2",
        "action": "tap",
        "targetDescription": "Perform login with valid credentials",
        "screenName": "LoginPage",
        "pageObjectMethod": "performLogin"
      },
      {
        "id": "s3",
        "action": "tap",
        "targetDescription": "Click Add to Cart for Sauce Labs Backpack",
        "screenName": "InventoryPage",
        "pageObjectMethod": "clickAddToCartSauceLabsBackpackSauceLabsBackpack"
      },
      {
        "id": "s4",
        "action": "tap",
        "targetDescription": "Click shopping cart icon",
        "screenName": "InventoryPage",
        "pageObjectMethod": "clickShoppingCart"
      },
      {
        "id": "s5",
        "action": "assertVisible",
        "targetDescription": "Verify Remove button for Sauce Labs Backpack is visible in cart",
        "screenName": "CartPage",
        "pageObjectMethod": "expectRemoveSauceLabsBackpackSauceLabsBackpackVisible"
      },
      {
        "id": "s6",
        "action": "tap",
        "targetDescription": "Click Remove button for Sauce Labs Backpack in cart",
        "screenName": "CartPage",
        "pageObjectMethod": "clickRemoveSauceLabsBackpackSauceLabsBackpack"
      },
      {
        "id": "s7",
        "action": "assertHidden",
        "targetDescription": "Verify cart badge is no longer visible",
        "locatorHint": ".shopping_cart_badge"
      },
      {
        "id": "s8",
        "action": "assertHidden",
        "targetDescription": "Verify item is no longer in cart",
        "locatorHint": ".cart_item"
      }
    ],
    "tags": [
      "@e2e",
      "@regression"
    ]
  }
}
