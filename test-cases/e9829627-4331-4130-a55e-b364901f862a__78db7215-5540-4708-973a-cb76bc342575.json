{
  "id": "78db7215-5540-4708-973a-cb76bc342575",
  "testPlanId": "e9829627-4331-4130-a55e-b364901f862a",
  "requirementId": "397f96ea-480b-48dd-99ed-2fcea12a8b5c",
  "suiteName": "PS-001 — Product Listing & Add to Cart E2E",
  "case": {
    "id": "78db7215-5540-4708-973a-cb76bc342575",
    "title": "E2E-011: Navigate to cart page from inventory and verify cart contents",
    "priority": "P0",
    "platforms": [
      "chrome"
    ],
    "preconditions": [
      "User has valid credentials: standard_user / secret_sauce"
    ],
    "steps": [
      {
        "id": "s1",
        "action": "openUrl",
        "targetDescription": "Navigate to SauceDemo login page",
        "value": "https://www.saucedemo.com/"
      },
      {
        "id": "s2",
        "action": "tap",
        "targetDescription": "Perform login with valid credentials",
        "screenName": "LoginPage",
        "pageObjectMethod": "performLogin"
      },
      {
        "id": "s3",
        "action": "tap",
        "targetDescription": "Click Add to Cart for Sauce Labs Backpack",
        "screenName": "InventoryPage",
        "pageObjectMethod": "clickAddToCartSauceLabsBackpackSauceLabsBackpack"
      },
      {
        "id": "s4",
        "action": "tap",
        "targetDescription": "Click shopping cart icon",
        "screenName": "InventoryPage",
        "pageObjectMethod": "clickShoppingCart"
      },
      {
        "id": "s5",
        "action": "assertVisible",
        "targetDescription": "Verify cart page title is visible",
        "screenName": "CartPage",
        "pageObjectMethod": "expectTitleVisible"
      },
      {
        "id": "s6",
        "action": "assertVisible",
        "targetDescription": "Verify inventory item name is visible in cart",
        "screenName": "CartPage",
        "pageObjectMethod": "expectInventoryItemNameVisible"
      },
      {
        "id": "s7",
        "action": "assertVisible",
        "targetDescription": "Verify inventory item description is visible in cart",
        "screenName": "CartPage",
        "pageObjectMethod": "expectInventoryItemDescVisible"
      },
      {
        "id": "s8",
        "action": "assertVisible",
        "targetDescription": "Verify inventory item price is visible in cart",
        "screenName": "CartPage",
        "pageObjectMethod": "expectInventoryItemPriceVisible"
      },
      {
        "id": "s9",
        "action": "assertContainsText",
        "targetDescription": "Verify item name in cart is Sauce Labs Backpack",
        "screenName": "CartPage",
        "pageObjectMethod": "expectInventoryItemNameContainsText",
        "assertion": "Sauce Labs Backpack"
      }
    ],
    "tags": [
      "@e2e",
      "@regression"
    ]
  }
}
