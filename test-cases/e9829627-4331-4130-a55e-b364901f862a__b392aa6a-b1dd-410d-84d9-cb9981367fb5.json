{
  "id": "b392aa6a-b1dd-410d-84d9-cb9981367fb5",
  "testPlanId": "e9829627-4331-4130-a55e-b364901f862a",
  "requirementId": "397f96ea-480b-48dd-99ed-2fcea12a8b5c",
  "suiteName": "PS-001 — Product Listing & Add to Cart E2E",
  "case": {
    "id": "b392aa6a-b1dd-410d-84d9-cb9981367fb5",
    "title": "E2E-006: Add product to cart from product detail page and verify cart count",
    "priority": "P1",
    "platforms": [
      "chrome"
    ],
    "preconditions": [
      "User has valid credentials: standard_user / secret_sauce"
    ],
    "steps": [
      {
        "id": "s1",
        "action": "openUrl",
        "targetDescription": "Navigate to SauceDemo login page",
        "value": "https://www.saucedemo.com/"
      },
      {
        "id": "s2",
        "action": "tap",
        "targetDescription": "Perform login with valid credentials",
        "screenName": "LoginPage",
        "pageObjectMethod": "performLogin"
      },
      {
        "id": "s3",
        "action": "tap",
        "targetDescription": "Click on Sauce Labs Backpack product title to navigate to detail page",
        "screenName": "InventoryPage",
        "pageObjectMethod": "clickItem4Title"
      },
      {
        "id": "s4",
        "action": "assertContainsText",
        "targetDescription": "Verify product name on detail page",
        "locatorHint": ".inventory_details_name",
        "assertion": "Sauce Labs Backpack"
      },
      {
        "id": "s5",
        "action": "tap",
        "targetDescription": "Click Add to Cart button on product detail page",
        "locatorHint": "[data-test='add-to-cart']"
      },
      {
        "id": "s6",
        "action": "assertText",
        "targetDescription": "Verify cart badge shows count of 1",
        "locatorHint": ".shopping_cart_badge",
        "assertion": "1"
      },
      {
        "id": "s7",
        "action": "assertVisible",
        "targetDescription": "Verify Remove button is shown on detail page after adding to cart",
        "locatorHint": "[data-test='remove']"
      }
    ],
    "tags": [
      "@e2e",
      "@regression"
    ]
  }
}
